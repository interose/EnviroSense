{% extends 'base.html.twig' %}

{% set colorInside = '#FFA500' %}
{% set colorOutside = '#1E90FF' %}

{% block body %}
<div class="row g-1 mt-2">
    {% include 'default/_dashboardItem.html.twig' with { 'colCount': 4, 'value': power.0.value, 'unit': power.0.unit, 'description' : power.0.name, 'type': 'power' } %}
    {% include 'default/_dashboardItem.html.twig' with { 'colCount': 4, 'value': power.1.value, 'unit': power.1.unit, 'description' : power.1.name, 'type': 'power' } %}
    {% include 'default/_dashboardItem.html.twig' with { 'colCount': 4, 'value': power.2.value, 'unit': power.2.unit, 'description' : power.2.name, 'type': 'power' } %}

    {% include 'default/_dashboardItem.html.twig' with { 'colCount': 12, 'value': power.3.value, 'unit': power.3.unit, 'description' : power.3.name, 'type': 'power' } %}
</div>

{% endblock %}
